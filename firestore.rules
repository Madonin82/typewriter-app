rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStationAdmin() {
      return request.auth != null && request.auth.uid in
        ['vW2BVmvIxQap7mYBhzUU1l7P0VH3', 'HQe2aRANHoOFFPofQyfPTUV4LXB2'];
    }

    function isAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isVerifiedUser() {
      return request.auth != null
        && !isAnonymous()
        && request.auth.token.email_verified == true;
    }

    function stationKeysAreValid() {
      return request.resource.data.keys().hasOnly([
        'ownerUid', 'isGuest', 'title', 'stationName', 'isLive', 'liveDraft',
        'pages', 'display', 'updatedAt', 'lastWrite', 'lastUpdateAddedPages'
      ]);
    }

    function stationContentIsValid() {
      return request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && request.resource.data.stationName is string
        && request.resource.data.stationName.size() <= 40
        && request.resource.data.liveDraft is string
        && request.resource.data.liveDraft.size() <= 50000
        && request.resource.data.pages is list
        && request.resource.data.pages.size() <= 50000
        && request.resource.data.lastUpdateAddedPages is number;
    }

    function existingStationIsGuest() {
      return resource.data.keys().hasAll(['isGuest']) && resource.data.isGuest == true;
    }

    // Private writer data is available only to its owner with a verified email.
    // Anonymous users are intentionally excluded from both this match and its recursive children.
    match /users/{userId} {
      allow read, write: if isVerifiedUser() && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if isVerifiedUser() && request.auth.uid == userId;
      }
    }

    // Station is public to read. Writers must use the fixed schema and stamp lastWrite.
    match /station/{bookId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.isGuest == isAnonymous()
                    && stationKeysAreValid()
                    && stationContentIsValid();

      allow update: if request.auth != null
                    && stationKeysAreValid()
                    && stationContentIsValid()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.isGuest == existingStationIsGuest()
                    && (
                      isStationAdmin()
                      || (resource.data.ownerUid == request.auth.uid
                          && ((!isAnonymous()) || existingStationIsGuest()))
                    );

      allow delete: if request.auth != null
                    && (isStationAdmin()
                        || (resource.data.ownerUid == request.auth.uid
                            && ((!isAnonymous()) || existingStationIsGuest())));
    }

    // Chatroom rules: authenticated users can read and write in the shared room
    match /chatrooms/{roomId} {
      allow read: if request.auth != null;

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
        allow update, delete: if request.auth != null && (isStationAdmin() || resource.data.senderUid == request.auth.uid);
      }

      match /drafts/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /galleryExhibits/{exhibitId} {
      allow read: if true;

      // Portal doorway: when present, the room must live in our own Storage
      // gallery folder. We store the Storage *path* (tokens die on re-upload,
      // paths don't) and resolve it to a download URL at render time.
      function validPortal(data) {
        return !('portal' in data) || (
          data.portal is map
          && data.portal.path is string
          && data.portal.path.matches('^gallery/[^/]+/.+')
          && (!('title' in data.portal) || data.portal.title is string)
        );
      }

      allow create: if isVerifiedUser()
                    && request.resource.data.uploaderUid == request.auth.uid
                    && request.resource.data.url is string
                    && (!('uploaderName' in request.resource.data) || request.resource.data.uploaderName is string)
                    && validPortal(request.resource.data);

      allow update: if isStationAdmin()
                    && validPortal(request.resource.data);

      allow delete: if isStationAdmin();
    }

    match /userDirectory/{uid} {
      allow read: if isStationAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Cloud exports: a signed-in writer stores a compiled manuscript in
    // Storage under /exports/{uid}/ and records it here, so the Admin page
    // can list it and the writer (human or AI agent) can share the
    // download link without an admin request. Entries are immutable and
    // disposable: owners and station admins can delete them, which (with
    // the Storage delete) retires the link.
    match /exports/{exportId} {
      allow read: if isStationAdmin()
                  || (isVerifiedUser() && resource.data.ownerUid == request.auth.uid);

      allow create: if isVerifiedUser()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'bookId', 'bookTitle', 'format', 'fileName',
                      'sizeBytes', 'storagePath', 'downloadUrl', 'createdAt'
                    ])
                    && request.resource.data.bookId is string
                    && request.resource.data.bookTitle is string
                    && request.resource.data.bookTitle.size() <= 500
                    && request.resource.data.format in ['txt', 'md', 'json']
                    && request.resource.data.fileName is string
                    && request.resource.data.fileName.size() <= 200
                    && request.resource.data.sizeBytes is number
                    && request.resource.data.sizeBytes <= 52428800
                    && request.resource.data.storagePath is string
                    && request.resource.data.storagePath.matches('exports/' + request.auth.uid + '/.*')
                    && request.resource.data.downloadUrl is string
                    && request.resource.data.downloadUrl.size() <= 2048
                    && request.resource.data.createdAt is timestamp;

      allow update: if false;

      allow delete: if isStationAdmin()
                    || (isVerifiedUser() && resource.data.ownerUid == request.auth.uid);
    }

    // VR room layouts: public to read, room admins only to write.
    // Room admins are the station admins for now; if that ever needs to
    // differ, add a separate isRoomAdmin() with its own UID list here.
    // NOTE: overlap/collision is enforced by the shared layout-store code —
    // security rules cannot do 3D math, so every editor must use it.
    match /vrRooms/{roomId} {
      allow read: if true;

      match /placements/{placementId} {
        allow read: if true;

        allow create, update: if isStationAdmin()
          && request.resource.data.keys().hasOnly(
               ['item', 'cell', 'rotY', 'wall', 'parent', 'version'])
          && request.resource.data.item is string
          && request.resource.data.cell is map
          && request.resource.data.cell.keys().hasOnly(['x', 'y', 'z'])
          && request.resource.data.cell.x is int
          && request.resource.data.cell.y is int
          && request.resource.data.cell.z is int
          && request.resource.data.rotY is number;

        allow delete: if isStationAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
