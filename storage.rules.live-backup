// LIVE BACKUP — Storage rules as deployed in the Firebase console on
// 2026-09-27 (pasted by Jimmy). This is the rollback target: if the
// hardened storage.rules on this branch ever misbehave in production,
// redeploy THIS file to restore the exact live behavior.
// Do not edit. Do not deploy from this branch by accident.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /gallery/{userId}/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.uid in ['vW2BVmvIxQap7mYBhzUU1l7P0VH3', 'HQe2aRANHoOFFPofQyfPTUV4LXB2']);
    }
  }
}
